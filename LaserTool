local function getServerCode(featureName)
    local success, response = pcall(function()
        return request({
            Url = SERVER_URL .. "/get-feature",
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ feature = featureName })
        })
    end)
    if success and response.StatusCode == 200 then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.code then
            if featureName == "color_structure" then
                script:SetAttribute("ColorStructCode", data.code)
            end
            return loadstring(data.code)
        end
    end
    return nil
end

