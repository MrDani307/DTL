            TweenService:Create(StatusPulse, TweenInfo.new(0.3), {BackgroundColor3 = Theme.danger}):Play()
            cleanUp()
            ToastSystem.show("Laser tracking disabled", 2, Theme.danger)
        end
    end)
end)

